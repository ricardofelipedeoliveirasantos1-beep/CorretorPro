rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    // Validates if the user has an active membership in the workspace.
    function hasWorkspaceAccess(workspaceId) {
      return isSignedIn() &&
             get(path('/databases/' + database + '/documents/memberships/' + request.auth.uid + '_' + workspaceId)).data.status == 'active';
    }

    // Validates if the user is an owner in the workspace.
    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() &&
             get(path('/databases/' + database + '/documents/memberships/' + request.auth.uid + '_' + workspaceId)).data.workspaceId == workspaceId &&
             get(path('/databases/' + database + '/documents/memberships/' + request.auth.uid + '_' + workspaceId)).data.role == 'owner';
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }
    
    match /workspaces/{workspaceId} {
      // Allow read/update if the user is the owner
      allow read, update: if isWorkspaceOwner(workspaceId);
      
      // Allow create ONLY if ownerUid is the requesting user and the ID matches the expected deterministic ID
      allow create: if isSignedIn() && 
                    request.resource.data.ownerUid == request.auth.uid &&
                    workspaceId == 'workspace_' + request.auth.uid;
      
      allow delete: if false; // Not allowed in this phase
    }
    
    match /memberships/{membershipId} {
      // Users can read memberships if it belongs to them
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow creation of the initial deterministic owner membership
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.role == 'owner' &&
                    request.resource.data.workspaceId == 'workspace_' + request.auth.uid &&
                    membershipId == request.auth.uid + '_workspace_' + request.auth.uid;
                    
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    
    // Business Data Rules 
    match /clients/{document=**} {
      allow read: if hasWorkspaceAccess(resource.data.workspaceId);
      allow create: if hasWorkspaceAccess(request.resource.data.workspaceId);
      allow update: if hasWorkspaceAccess(resource.data.workspaceId) && 
                       request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if hasWorkspaceAccess(resource.data.workspaceId);
    }
    
    match /properties/{document=**} {
      allow read: if hasWorkspaceAccess(resource.data.workspaceId);
      allow create: if hasWorkspaceAccess(request.resource.data.workspaceId);
      allow update: if hasWorkspaceAccess(resource.data.workspaceId) && 
                       request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if hasWorkspaceAccess(resource.data.workspaceId);
    }
    
    match /deals/{document=**} {
      allow read: if hasWorkspaceAccess(resource.data.workspaceId);
      allow create: if hasWorkspaceAccess(request.resource.data.workspaceId);
      allow update: if hasWorkspaceAccess(resource.data.workspaceId) && 
                       request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if hasWorkspaceAccess(resource.data.workspaceId);
    }
    
    match /commissions/{document=**} {
      allow read: if hasWorkspaceAccess(resource.data.workspaceId);
      allow create: if hasWorkspaceAccess(request.resource.data.workspaceId);
      allow update: if hasWorkspaceAccess(resource.data.workspaceId) && 
                       request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if hasWorkspaceAccess(resource.data.workspaceId);
    }
    
    match /interests/{document=**} {
      allow read: if hasWorkspaceAccess(resource.data.workspaceId);
      allow create: if hasWorkspaceAccess(request.resource.data.workspaceId);
      allow update: if hasWorkspaceAccess(resource.data.workspaceId) && 
                       request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if hasWorkspaceAccess(resource.data.workspaceId);
    }
    
    match /appointments/{document=**} {
      allow read: if hasWorkspaceAccess(resource.data.workspaceId);
      allow create: if hasWorkspaceAccess(request.resource.data.workspaceId);
      allow update: if hasWorkspaceAccess(resource.data.workspaceId) && 
                       request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if hasWorkspaceAccess(resource.data.workspaceId);
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
